# LLM API Configuration
# Supports any OpenAI-compatible endpoint (DeepSeek, DashScope, ZenMux, etc.)
#
# 本文件只是示例模板（会被提交进仓库），请勿填写真实密钥。
# 真实密钥请复制为 .env 后填写，.env 已被 .gitignore 忽略。
#
# 密钥按 provider 读取（配置文件的 api_key 留空时才会回退到环境变量）：
#   deepseek  -> DEEPSEEK_API_KEY / DEEPSEEK_API_BASE
#   dashscope -> DASHSCOPE_API_KEY / DASHSCOPE_API_BASE
#   zenmux    -> ZENMUX_API_KEY / ZENMUX_API_BASE
# 通用兜底：LLM_API_KEY / LLM_API_BASE
DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 登录账号（可选）。格式：user1:pass1,user2:pass2
# 不设置时使用代码内置账户。建议用环境变量配置，避免口令入库。
# GAME_USERS=alice:password1,bob:password2
